{
  "type": "object",
  "properties": {
    "archetype": {
      "type": "string",
      "enum": [
        "why_this_project",
        "build_walkthrough",
        "what_went_wrong",
        "i_was_wrong",
        "tool_review",
        "specific_gotcha",
        "retrospective",
        "video_walkthrough"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "angle": { "type": "string", "minLength": 1 },
    "target_platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["site", "linkedin", "facebook", "youtube"] }
    },
    "demand": {
      "type": "object",
      "properties": {
        "recurrence": { "type": "integer", "minimum": 0 },
        "signals": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["recurrence", "signals"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "note": { "type": ["string", "null"] },
          "quote": { "type": ["string", "null"] }
        },
        "required": ["kind", "ref"],
        "additionalProperties": false
      }
    },
    "grounding_strength": { "type": "string", "enum": ["strong", "moderate", "weak"] },
    "weakest_point": { "type": "string", "minLength": 1 },
    "risk_flags": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "archetype",
    "title",
    "angle",
    "target_platforms",
    "demand",
    "evidence",
    "grounding_strength",
    "weakest_point",
    "risk_flags"
  ],
  "additionalProperties": false
}
